# Copy to .env and replace every placeholder before exposing the service.
# These values are safe only for a private local Compose network.

POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=agent_platform
DATABASE_URL=postgres://agent:change-me-now@postgres:5432/agent_platform

REDIS_URL=redis://redis:6379

# At least 32 characters. The API refuses the documented placeholder at startup
# only as a warning; replace it anyway.
APP_MASTER_KEY=local-dev-master-key-change-me-32
SESSION_SECRET=local-dev-session-secret-change
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
COOKIE_SECURE=false

WORKSPACES_DIR=/var/lib/agent-platform/workspaces
API_PORT=4000
WORKER_PORT=4001
WEB_PORT=3000
API_INTERNAL_URL=http://api:4000

WORKER_CONCURRENCY=2
MAX_RUNNING_AGENTS=4
TICK_INTERVAL_MS=15000

# process | container
DOCKER_RUNTIME=false
AGENT_RUNTIME_IMAGE=agent-platform-runtime:local
AGENT_DOCKER_NETWORK=agent-platform-agents
AGENT_CONTAINER_MEMORY=1g
AGENT_CONTAINER_CPUS=1

# Optional model endpoints. Leave keys empty until you add a provider in the UI.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=
CURSOR_API_KEY=
CODEX_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public https origin Trello can reach, for example https://agents.example.com.
# Leave empty on a private machine. The worker still refreshes Trello every 60 seconds.
APP_PUBLIC_URL=

# Wall-clock timezone for containers, day budgets, and UI timestamps
TZ=Europe/Amsterdam
